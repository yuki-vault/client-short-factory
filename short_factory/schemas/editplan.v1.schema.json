{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://client-short-factory.local/schemas/editplan.v1.schema.json",
  "title": "Short Factory EditPlan C0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_id",
    "story_beats",
    "timeline_items",
    "presentation_events",
    "speech_captions",
    "editorial_overlays",
    "join_edges",
    "source_regions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/id"},
    "source_id": {"$ref": "#/$defs/id"},
    "story_beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/storyBeat"}
    },
    "timeline_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 36,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/sourceClip"},
          {"$ref": "#/$defs/generatedCard"}
        ]
      }
    },
    "presentation_events": {
      "type": "array",
      "maxItems": 24,
      "items": {"$ref": "#/$defs/presentationEvent"}
    },
    "speech_captions": {
      "type": "array",
      "maxItems": 80,
      "items": {"$ref": "#/$defs/speechCaption"}
    },
    "editorial_overlays": {
      "type": "array",
      "maxItems": 80,
      "items": {"$ref": "#/$defs/editorialOverlay"}
    },
    "join_edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/joinEdge"}
    },
    "source_regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["person", "content", "comment"],
      "properties": {
        "person": {"$ref": "#/$defs/nullableRect"},
        "content": {"$ref": "#/$defs/nullableRect"},
        "comment": {"$ref": "#/$defs/nullableRect"}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "positiveInteger": {"type": "integer", "minimum": 1},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "storyBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "source_order_lock", "timeline_item_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {
          "enum": ["hook", "setup", "development", "reaction", "payoff", "aftertaste"]
        },
        "source_order_lock": {"type": "boolean"},
        "timeline_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 36,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "sourceClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "story_beat_id", "video_in_pts", "video_out_pts",
        "audio_in_sample", "audio_out_sample"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "source_clip"},
        "story_beat_id": {"$ref": "#/$defs/id"},
        "video_in_pts": {"type": "integer"},
        "video_out_pts": {"type": "integer"},
        "audio_in_sample": {"$ref": "#/$defs/nonNegativeInteger"},
        "audio_out_sample": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "generatedCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "story_beat_id", "duration_frames", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "generated_card"},
        "story_beat_id": {"$ref": "#/$defs/id"},
        "duration_frames": {"$ref": "#/$defs/positiveInteger"},
        "text": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "presentationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeline_item_id", "source_in_pts", "source_out_pts", "layout"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "timeline_item_id": {"$ref": "#/$defs/id"},
        "source_in_pts": {"type": "integer"},
        "source_out_pts": {"type": "integer"},
        "layout": {"enum": ["standard", "person", "content", "split", "comment"]}
      }
    },
    "speechCaption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeline_item_id", "source_in_pts", "source_out_pts", "text", "role", "token_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "timeline_item_id": {"$ref": "#/$defs/id"},
        "source_in_pts": {"type": "integer"},
        "source_out_pts": {"type": "integer"},
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "role": {"enum": ["normal", "comment", "quote", "emphasis"]},
        "token_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "editorialOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeline_item_id", "local_in_frame", "local_out_frame", "kind", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "timeline_item_id": {"$ref": "#/$defs/id"},
        "local_in_frame": {"$ref": "#/$defs/nonNegativeInteger"},
        "local_out_frame": {"$ref": "#/$defs/positiveInteger"},
        "kind": {"enum": ["chapter_card", "comment_card", "context"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "joinEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_item_id", "to_item_id", "audio_transition"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from_item_id": {"$ref": "#/$defs/id"},
        "to_item_id": {"$ref": "#/$defs/id"},
        "audio_transition": {"enum": ["hard", "micro_fade"]}
      }
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 1000000},
        {"type": "integer", "minimum": 0, "maximum": 1000000},
        {"type": "integer", "minimum": 1, "maximum": 1000000},
        {"type": "integer", "minimum": 1, "maximum": 1000000}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "nullableRect": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/rect"}]
    }
  }
}
